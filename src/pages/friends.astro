---
import { getEntry, render } from "astro:content";

import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import { friendsConfig } from "@/config";
import FriendsPanel from "@components/friendsPanel.svelte";
import FriendlinkApply from "@components/friendlinkApply.svelte";
import { localFriendGroups } from "@utils/friends";
import Markdown from "@components/common/markdown.astro";
import Comment from "@components/comment.astro";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";


const friendsPost = await getEntry("spec", "friends");
if (!friendsPost) {
    throw new Error("friends page content not found");
}
const pageTitle = friendsPost.data.title || LinkPresets[LinkPreset.Friends].name;
const pageDescription = friendsPost.data.description || LinkPresets[LinkPreset.Friends].description;

const { Content, headings } = await render(friendsPost);

// 将页面主标题添加到目录中
const allHeadings = [
    { depth: 1, slug: "friends-page-title", text: pageTitle },
    ...headings
];
---

<GridLayout title={pageTitle} description={pageDescription} headings={allHeadings}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-4">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <BackwardButton currentPath={Astro.url.pathname} />
            <!-- 标题 -->
            <header class="mb-8">
                <h1 id="friends-page-title" class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
                    {pageTitle}
                </h1>
                {pageDescription && (
                    <p class="text-neutral-600 dark:text-neutral-400">
                        {pageDescription}
                    </p>
                )}
            </header>
            <FriendsPanel
                client:load
                source={friendsConfig.source}
                remoteUrl={friendsConfig.remoteUrl}
                localGroups={localFriendGroups}
                graveyardUrl={friendsConfig.graveyardUrl}
                graveyardTitle={friendsConfig.graveyardTitle}
                graveyardDescription={friendsConfig.graveyardDescription}
            />
            <Markdown class="mt-2">
                <Content />
            </Markdown>
            <FriendlinkApply client:load />
        </div>
    </div>
    <Comment path="/friends/" />
</GridLayout>